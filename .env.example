# ─── Supabase ────────────────────────────────────────────────────────────────
# The two NEXT_PUBLIC_ values are shipped to the browser and are safe to expose.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security: it is read only on the
# server (lib/supabase.ts, app/api/upload) and must never be prefixed with
# NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Postgres connections, for migrations and psql. Not used at runtime.
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:port/database"

# ─── Authentication ──────────────────────────────────────────────────────────
# NEXTAUTH_SECRET signs the session JWT. Generate with: openssl rand -base64 32
# An unset secret means sessions cannot be verified and every admin request is
# rejected in production.
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Without RESEND_API_KEY, enquiries are still stored — the notification is
# skipped and a warning is logged.
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Must be a domain verified in Resend. The default sandbox sender only delivers
# to the Resend account owner.
RESEND_FROM="Mindfire Homes <hello@mindfirehomes.com>"
# Where new-enquiry alerts are sent. Defaults to OFFICE.email in lib/contact.ts.
LEAD_NOTIFICATION_EMAIL="hello@mindfirehomes.com"

# ─── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ─── Canonical site URL ──────────────────────────────────────────────────────
# Used for canonical links, Open Graph URLs, sitemap.xml, and robots.txt. Set
# this to the production origin, with no trailing slash.
NEXT_PUBLIC_SITE_URL="https://mindfirehomes.com"

# ─── Payment gateways (not yet implemented) ──────────────────────────────────
PAYSTACK_PUBLIC_KEY="pk_test_xxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxx"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxx"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxx"
FLUTTERWAVE_ENCRYPTION_KEY="FLWSECK_TESTxxxxx"
